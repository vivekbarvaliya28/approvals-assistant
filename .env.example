# Copy to .env.local and fill in. Never commit .env.local.
# Without a key the app still runs: every AI action serves its deterministic fallback.
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# Free option, e.g. Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
LLM_TIMEOUT_MS=8000
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000
